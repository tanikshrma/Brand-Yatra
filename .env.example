# Public base URL for canonical metadata, sitemap.xml, and robots.txt
APP_URL="https://your-production-domain.com"

# Server port (defaults to 3000)
PORT="3000"

# Resend transactional email configuration for POST /api/contact
# Never expose these variables in client-side VITE_* variables.
RESEND_API_KEY="YOUR_RESEND_API_KEY"
CONTACT_TO_EMAIL="hello@brandyatra.com"
CONTACT_FROM_EMAIL="Brand Yatra Inquiries <inquiries@your-verified-domain.com>"
